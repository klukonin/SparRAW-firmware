/* SPDX-License-Identifier: AGPL-3.0-or-later
 * Строки журнала fw SparRAW (include/logstr.h): X(ИМЯ, "формат"), токен LS_FW(ИМЯ). Один строковый литерал
 * на запись (build_fw.py и декодеры читают файл регулярным выражением). Новые — в конец: порядок задаёт
 * токены, но образ всегда несёт свою таблицу, поэтому перестановка допустима. Аргументов — не больше 3. */
X(FW_LOGSTR_RESERVED, "fw: SparRAW log strings")
X(CALIB_UT_BAD_ENGINE, "calib_mgr_ut: engine index %u out of range (engines %u), ignored")
X(WMI_BAD_PARAM, "wmi cmd 0x%x: invalid value %u at +0x%x, rejected")
X(BA_DIS_NO_STREAM, "WMI_VRING_BA_DIS for vring %u without a stream (after disconnect), ignored")
X(RCP_DELBA_NO_CONN, "WMI_RCP_DELBA for cid %u without a connection (after disconnect), ignored")
X(WMI_NOT_SUPPORTED, "---->> [HOST CMD] WMI_COMMAND_NOT_SUPPORTED_EVENT command 0x%x subtype 0x%x mid %u")
X(WMI_NO_VIF, "wmi cmd 0x%x: mid %u has no VIF in fw, not supported")
X(RFC_READ_FAILED, "hwd_rfc_read_rgf: RF reg 0x%x read failed after 5 trials (rf mask 0x%x, read_valid %u), returning 0xdeadbeef")
X(SELFTX_TIMEOUT, "calib self-TX did not finish: remaining %u frames, busy 0x%x")
X(PCIE_MAIN_UNHANDLED, "UN HANDLED PCIE PERST/D3 INTERRUPT (CAUSE=0x%x)")
X(RX_BAD_QID, "rx mgmt frame with qid %u (cid %u, mid %u): neither 0 nor 1")
X(UC_EVT_UNKNOWN, "unknown ucode event type 0x%x, tsf 0x%08x %08x")
X(RS_DONE_FAILED, "rate search end failed: cid %u status %u (mcs %u)")
X(POOL_EXHAUSTED, "mem_pool 0x%x exhausted: %u cells in use (cell size %u)")
X(POOL_LIST_EMPTY, "mem_pool 0x%x: free list empty with %u of %u cells in use")
X(FW2UC_NO_ACK, "fw->ucode signal (ICR bit %u) not acknowledged after %u rounds, ICR 0x%x")
X(HW_POLL_TIMEOUT, "hw poll timeout: reg 0x%x = 0x%x, waited for mask 0x%x")
X(MAC_CNT_CLEAR_TIMEOUT, "MAC counters clear: phase %u not acknowledged, ctrl 0x%x")
X(LISTEN_STARTED_EVT, "<<---- [HOST EVENT] WMI_LISTEN_STARTED_EVENTID mid %u status %u")
X(REASSOC_INPLACE, "AP reassoc in place: cid %u reassoc_req %u status %u")
X(REASSOC_INPLACE_DONE, "AP reassoc in place: cid %u tx status 0x%x resp status %u")
