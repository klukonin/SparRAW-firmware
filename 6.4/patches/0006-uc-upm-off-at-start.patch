uc: UPM (PS без графика) при старте выключен

bi_ctx__clear_counters ставил upm_enable = 1 с тайм-аутом простоя 30 мс.
В 6.2 вход в doze был заперт договором PSC, и это не проявлялось; после
снятия гейта (ps__hold_awake_if_active) станция засыпала бы после первого
скана при любом профиле хоста.  По 11.2.7.1 станция начинает в active
mode; UPM включает хост (LMAC 0x33).
--- a/src/asm/uc/_unknown/bi_ctx__clear_counters.S
+++ b/src/asm/uc/_unknown/bi_ctx__clear_counters.S
@@ -62,7 +62,10 @@ L_92ae70:
 L_92ae74:
 	mov_s r1,0xff
 L_92ae76:
-	mov_s r0,0x1
+	/* 6.4: UPM (PS без графика) при старте выключен — станция начинает в
+	 * active mode (802.11-2020 11.2.7.1), включает UPM только хост (LMAC 0x33).
+	 * В 6.2 здесь было 1, и без договора PSC это не проявлялось. */
+	mov_s r0,0x0
 L_92ae78:
 	stb r14,[r15, -0x9b]
 L_92ae7c:
