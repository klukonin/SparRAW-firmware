fw: станция принимает маяк точки с расписанием (CBAP Only = 0)

dmg_bcon__rx_handler считал маяк своего BSS только при «CBAP Only = 0 ⇔
включено вендорское фиксированное расписание».  Стандартная точка с ESE
ставит CBAP Only = 0 (802.11-2020 10.39.6.3), и станция без
фиксированного расписания её маяки отбрасывала целиком: ни разбора ESE,
ни события BCON_RX, ни сторожа маяков.  Теперь маяк не свой только при
фиксированном расписании и CBAP Only = 1.  Длина кода та же.
--- a/src/asm/fw/_unknown/dmg_bcon__rx_handler.S
+++ b/src/asm/fw/_unknown/dmg_bcon__rx_handler.S
@@ -79,13 +79,18 @@ L_8c9450:
 L_8c9456:
 	lsr_s r0,r0,0x2
 L_8c9458:
-	bxor r0,r0,0x0
+	/* 6.4: без инверсии — r0 = CBAP Only */
+	mov 0x0,0x0
 L_8c945c:
 	ldb_s r15,[r3,0x5]
 L_8c945e:
 	bmsk_s r0,r0,0x0
 L_8c9460:
-	rsub.f r15,r15,r0
+	/* 6.4: маяк не свой только при вендорском фиксированном расписании и
+	 * CBAP Only = 1.  В 6.2 было «CBAP Only = 0 ⇔ фиксированное расписание»,
+	 * и маяк стандартной точки с ESE (CBAP Only = 0, 802.11-2020 10.39.6.3)
+	 * станция отбрасывала целиком — вместе с разбором ESE и сторожем маяков. */
+	and.f r15,r15,r0
 L_8c9464:
 	mov.ne r15,0x1
 	.global L_8c9468
