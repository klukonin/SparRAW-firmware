+	.byte 0x00,0x67,0x00,0x67,0xc6,0xc6,0xc6,0xc6,0xc6,0xc6,0x79 /* 902540: 6.4 — подтип 2 (Reassociation Request) → ветка Assoc Req (0x00) */
