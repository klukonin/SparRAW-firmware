uc: конец слота A-BFT по стандарту

Таблица конца слота A-BFT (0x80167c) в 6.2 на 3300 тактов (20 мкс) дальше
aSSSlotTime: ответчик считает себя внутри слота, когда слот уже кончился.
В 4.1 не учтено время распространения (100 нс).  Значение по 802.11-2020,
10.42.5.2: aAirPropagationTime + aSSDuration + MBIFS + aSSFBDuration + MBIFS.
--- a/src/data/uc_data.S
+++ b/src/data/uc_data.S
@@ -407,10 +407,15 @@ abft_slot_ssw_us:
 /* 941664: N кадров SSW (TXTIME SSW + SBIFS = 2624 такта на кадр), такты */
 abft_slot_ssw_clk:
 	.hword 12955, 15579, 18203, 20827, 23451, 26075, 28699, 31323, 33947, 36571, 39195, 41819
-/* 94167c: конец слота — abft_slot_ssw_clk + 9281 такт (стандарт:
- * + MBIFS + SSW-Feedback + MBIFS = 5981; у 6.2 ещё 3300 = 20 мкс) */
+/* 94167c: конец слота = aSSSlotTime (802.11-2020, 10.42.5.2):
+ *   aAirPropagationTime + aSSDuration + MBIFS + aSSFBDuration + MBIFS,
+ * где aSSDuration = abft_slot_ssw_clk, aAirPropagationTime = 100 нс
+ * (табл. 20-30), MBIFS = 3 x aSIFSTime = 9 мкс, aSSFBDuration =
+ * TXTIME(SSW-Feedback) = 18,25 мкс: + 36,35 мкс = + 5998 тактов.
+ * 4.1 брала + 5981 (без времени распространения), 6.2 — + 9281 (на 20 мкс
+ * за концом слота). */
 abft_slot_end_clk:
-	.hword 22236, 24860, 27484, 30108, 32732, 35356, 37980, 40604, 43228, 45852, 48476, 51100
+	.hword 18953, 21577, 24201, 26825, 29449, 32073, 34697, 37321, 39945, 42569, 45193, 47817
 	.byte 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 /* 941694 */
 	.byte 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 /* 94169f ................ */
 	.byte 0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00,0x00 /* 9416af ................ */
